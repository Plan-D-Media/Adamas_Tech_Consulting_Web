# ── Database (Neon, PostgreSQL 16) ──────────────────────────────
# Pooled connection (PgBouncer) used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/adamas?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/adamas?sslmode=require"
# Local Docker alternative (docker compose up -d):
# DATABASE_URL="postgresql://adamas:adamas_dev@localhost:5432/adamas"
# DIRECT_URL="postgresql://adamas:adamas_dev@localhost:5432/adamas"

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Default homepage for visitors outside IN / UK+IE / GCC: in | uk | gcc
DEFAULT_REGION="uk"
# development | staging | production. Drafts can only be previewed outside production.
SITE_ENV="development"
# true also renders DRAFT content (local review only)
PREVIEW_DRAFTS="false"
# true shows orange "Draft" badges on draft content (internal review); keep false for client previews
SHOW_DRAFT_BADGES="false"
# true on staging: noindex everywhere + robots Disallow
BLOCK_INDEXING="true"
# Staging only: when both are set, every route (pages, /_next, media, API) needs these Basic Auth credentials (proxy.ts).
# Leave both empty locally and at launch.
PREVIEW_USERNAME=""
PREVIEW_PASSWORD=""

# ── Media ───────────────────────────────────────────────────────
# Local: /media (served from public/media). Production: https://dxxxx.cloudfront.net
MEDIA_BASE_URL="/media"

# ── Mail ────────────────────────────────────────
# console (the default) only logs each message; smtp sends it through the relay below. Nothing is emailed until
# MAILER=smtp AND SMTP_HOST are both set. Every submission is written to the database first either way, so no
# lead is lost while this is unset.
MAILER="console"            # console | smtp
MAIL_FROM="AdamasTech Website <no-reply@adamastechconsulting.com>"
# The ONE inbox every lead form on the site delivers to - all three regions, no per-region routing: the contact
# form on /in/, /uk/ and /gcc/, /contact (where every "Talk to an expert" and "Discuss This Service" button on
# the service, sub-service and case-study pages lands), the event registration's organiser copy, and the
# newsletter notification. Delivery only: the addresses displayed on the site come from the seeded content.
MAIL_TO_ENQUIRIES="marketing@adamastech.in"

# The relay, read only when MAILER=smtp. Port 587 is STARTTLS, 465 is implicit TLS.
# Google Workspace: smtp.gmail.com / 587 / the mailbox address / a 16-character app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Analytics (Milestone 3) ─────────────────────────────────────
# Google Tag Manager container, e.g. GTM-XXXXXXX. Empty means no analytics at all: no script, no consent banner,
# no consent cookie, and the Google hosts stay out of the Content-Security-Policy. See docs/deploy.md.
NEXT_PUBLIC_GTM_ID=""

# ── Cache ───────────────────────────────────────────────────────
# Shared secret for POST /api/revalidate (seed + future CMS)
REVALIDATE_SECRET=""
